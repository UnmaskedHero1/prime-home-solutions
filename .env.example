# Folder Nixpacks / Coolify should keep on a persistent volume.
# On the server this is usually /app/databases
DATABASE_DIR=databases

# Comma-separated origins for local Vite. Production is same-origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Password for the /admin page where site photos are uploaded.
# Required on Coolify. If empty, admin login is turned off.
ADMIN_PASSWORD=change-me
